---
import '~/styles/global.css';
import SEO from '~/components/SEO.astro';
import LocalBusinessSchema from '~/components/LocalBusinessSchema.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import ClientLogos from '~/components/ClientLogos.astro';
import GlobalBackground from '~/components/GlobalBackground.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import type { BreadcrumbEntry } from '~/lib/schema';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: 'website' | 'article';
  breadcrumbs?: BreadcrumbEntry[];
}

const { title, description, image, noindex, canonical, ogType, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Sets .dark before first paint so there's no flash of the wrong theme.
         Runs synchronously, blocking, before any CSS renders — must stay
         inline and tiny. Mirrors what ThemeToggle.astro writes on click. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <!-- Favicon: the AllTech logo, square-padded from /public/logo.webp.
         (The old generic favicon.svg — dark square + amber dot — was listed
         last, so browsers preferred it over the real logo.) -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts — preconnect for fast load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      canonical={canonical}
      ogType={ogType}
    >
      <LocalBusinessSchema />
      <slot name="head" />
    </SEO>

    <!--
      Cloudflare Web Analytics — privacy-friendly, no cookies, free.
      Replace TOKEN_HERE with your token from Cloudflare dashboard.
    -->
    <!-- <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "TOKEN_HERE"}'></script> -->
  </head>
  <body class="min-h-screen flex flex-col relative isolate">
    <!-- Skip link: hidden until keyboard-focused, lets keyboard/screen-reader
         users bypass the header nav (mega-menu + several top-level links)
         straight to the page content. WCAG 2.4.1 Bypass Blocks. -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Page-wide ambient background — a fixed mesh-glow wallpaper behind
         the whole page, including behind the header. `.surface-dark`
         sections are transparent (see global.css) so this shows through
         consistently. -->
    <GlobalBackground />
    <Header />
    <!-- No overflow-hidden here (deliberately): ANY non-"visible" overflow
         value on this element — even overflow-x alone, since the CSS spec
         forces the other axis from "visible" to "auto" the moment one axis
         isn't "visible" — turns <main> into a scroll container. <main>
         itself never actually scrolls (the document does), so doing that
         hijacks position:sticky's containing-block lookup for every sticky
         descendant on the page and silently breaks all of them (confirmed:
         this is why the services21 sticky panel never stuck). Sections that
         need to clip their own decorative bleed (glow-amber, hero
         backgrounds) already apply overflow-hidden locally to themselves —
         see e.g. any `surface-dark relative overflow-hidden` hero section. -->
    <main id="main-content" tabindex="-1" class="flex-1 relative">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="container-wide pt-6">
          <Breadcrumbs crumbs={breadcrumbs} />
        </div>
      )}
      <slot />
    </main>
    <ClientLogos />
    <Footer />

    <!-- Pointer-tracking spotlight + "decrypting" character layer for
         .card-feature-tile / .card-feature-wide (global.css). Global here
         rather than duplicated per-page because those cards live on 26
         different pages; one delegated listener covers all of them
         site-wide, and Astro dedupes/bundles this script once regardless of
         how many pages render on a given visit.
         Skipped entirely on touch devices — pointer: fine also weeds out
         devices that report a mouse but not fine control, matching the
         intent of a precision hover effect rather than "any pointer". -->
    <script>
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        // Enough characters to fill the largest card (the wide featured
        // card) at the CSS's 9px/1.3 line-height even after wrapping —
        // overflow: hidden in global.css clips the rest for smaller tiles,
        // so one fixed length works for both without measuring each card.
        const CHAR_COUNT = 2000;
        function randomString() {
          let s = '';
          for (let i = 0; i < CHAR_COUNT; i++) s += CHARS[(Math.random() * CHARS.length) | 0];
          return s;
        }

        // Regenerating the string on every pointermove (the effect this is
        // modeled on does exactly that) would mean writing 2000 characters
        // to the DOM 60+ times a second per hovered card. Throttled to
        // every 60ms instead — fast enough to still read as "shimmering",
        // cheap enough not to matter.
        let lastRegen = 0;

        document.addEventListener(
          'pointermove',
          (e) => {
            const card = (e.target as Element).closest<HTMLElement>('.card-feature-tile, .card-feature-wide');
            if (!card) return;
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
            card.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);

            const now = performance.now();
            if (now - lastRegen > 60) {
              lastRegen = now;
              const textLayer = card.querySelector<HTMLElement>(':scope > .card-spotlight-text');
              if (textLayer) textLayer.textContent = randomString();
            }
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
