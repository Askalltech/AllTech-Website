---
import '~/styles/global.css';
import SEO from '~/components/SEO.astro';
import LocalBusinessSchema from '~/components/LocalBusinessSchema.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import ClientLogos from '~/components/ClientLogos.astro';
import GlobalBackground from '~/components/GlobalBackground.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import type { BreadcrumbEntry } from '~/lib/schema';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: 'website' | 'article';
  breadcrumbs?: BreadcrumbEntry[];
}

const { title, description, image, noindex, canonical, ogType, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Sets .dark before first paint so there's no flash of the wrong theme.
         Runs synchronously, blocking, before any CSS renders — must stay
         inline and tiny. Mirrors what ThemeToggle.astro writes on click. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <!-- Favicon: the AllTech logo, square-padded from /public/logo.webp.
         (The old generic favicon.svg — dark square + amber dot — was listed
         last, so browsers preferred it over the real logo.) -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts — preconnect for fast load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      canonical={canonical}
      ogType={ogType}
    >
      <LocalBusinessSchema />
      <slot name="head" />
    </SEO>

    <!--
      Cloudflare Web Analytics — privacy-friendly, no cookies, free.
      Replace TOKEN_HERE with your token from Cloudflare dashboard.
    -->
    <!-- <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "TOKEN_HERE"}'></script> -->
  </head>
  <body class="min-h-screen flex flex-col relative isolate">
    <!-- Skip link: hidden until keyboard-focused, lets keyboard/screen-reader
         users bypass the header nav (mega-menu + several top-level links)
         straight to the page content. WCAG 2.4.1 Bypass Blocks. -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Page-wide ambient background — a fixed mesh-glow wallpaper behind
         the whole page, including behind the header. `.surface-dark`
         sections are transparent (see global.css) so this shows through
         consistently. -->
    <GlobalBackground />
    <Header />
    <!-- No overflow-hidden here (deliberately): ANY non-"visible" overflow
         value on this element — even overflow-x alone, since the CSS spec
         forces the other axis from "visible" to "auto" the moment one axis
         isn't "visible" — turns <main> into a scroll container. <main>
         itself never actually scrolls (the document does), so doing that
         hijacks position:sticky's containing-block lookup for every sticky
         descendant on the page and silently breaks all of them (confirmed:
         this is why the services21 sticky panel never stuck). Sections that
         need to clip their own decorative bleed (glow-amber, hero
         backgrounds) already apply overflow-hidden locally to themselves —
         see e.g. any `surface-dark relative overflow-hidden` hero section. -->
    <main id="main-content" tabindex="-1" class="flex-1 relative">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="container-wide pt-6">
          <Breadcrumbs crumbs={breadcrumbs} />
        </div>
      )}
      <slot />
    </main>
    <ClientLogos />
    <Footer />
  </body>
</html>
