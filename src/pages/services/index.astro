---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { services, serviceLink } from '~/lib/site';
import { Services13, type Services13Item, type Services13PhotoCredit } from '@/components/services13';

// Card photos — Unsplash License (attribution not legally required, but
// credited visibly on each card anyway, and here for the record).
const cardPhotos: Partial<Record<string, { image: string; credit: Services13PhotoCredit }>> = {
  'alltech-top-10': {
    image: '/services/top10-hero.webp',
    credit: { name: 'Umanoide', url: 'https://unsplash.com/photos/vA2B6bneZug' },
  },
  'cloudflare-zero-trust': {
    image: '/services/sase-hero.webp',
    credit: { name: 'Joel Filipe', url: 'https://unsplash.com/photos/RFDP7_80v5A' },
  },
  cybersecurity: {
    image: '/services/cybersecurity-card.webp',
    credit: { name: 'Maksim Samuilionak', url: 'https://unsplash.com/photos/tFvtQ2jzD5I' },
  },
  'network-design': {
    image: '/services/network-card.webp',
    credit: { name: 'Declan Sun', url: 'https://unsplash.com/photos/vNpQqHUzz58' },
  },
  install: {
    image: '/services/install-card.webp',
    credit: { name: 'Mathias Reding', url: 'https://unsplash.com/photos/5h2x_mHmsLc' },
  },
  'it-cloud': {
    image: '/services/it-cloud-card.webp',
    credit: { name: 'Brecht Corbeel', url: 'https://unsplash.com/photos/qtx68-0Qlbs' },
  },
  'remote-it-support': {
    image: '/services/remote-it-card.webp',
    credit: { name: 'Tai Bui', url: 'https://unsplash.com/photos/ws2Wtk34hnA' },
  },
  'utah-data-recovery': {
    image: '/services/data-recovery-card.webp',
    credit: { name: 'Patrick Lindenberg', url: 'https://unsplash.com/photos/1iVKwElWrPA' },
  },
};

const services13Items: Services13Item[] = services.map((service) => {
  const { href, external } = serviceLink(service);
  const featured = 'featured' in service ? service.featured : false;
  const photo = cardPhotos[service.slug];
  return {
    title: service.name,
    description: service.short,
    href,
    icon: service.icon as Services13Item['icon'],
    featured,
    hero: service.slug === 'alltech-top-10',
    external,
    image: photo?.image,
    photoCredit: photo?.credit,
  };
});
---

<BaseLayout
  title="IT Services & Cybersecurity in Northern Utah"
  description="Managed IT, cybersecurity, Cloudflare Zero Trust, UniFi network design, and Microsoft 365 services for businesses in Northern Utah and the Wasatch Front."
>
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="eyebrow mb-4">Services</div>
      <h1 class="font-display text-5xl lg:text-6xl font-semibold leading-tight max-w-3xl">
        Everything you need to run a <span style="color: var(--color-amber-400);">modern business network</span>.
      </h1>
      <p class="mt-6 text-xl max-w-2xl leading-relaxed text-muted">
        Pick a service to learn how we deliver it, or send us a note describing
        what you're trying to fix.
      </p>
    </div>
  </section>

  <section class="surface-dark" style="border-top: 1px solid var(--color-line-faint);">
    <Services13
      services={services13Items}
      eyebrow="Services"
      heading="Where to start"
      description="Every service we run, in one place. Pick one to see how we deliver it, or send us a note describing what you're trying to fix."
      client:visible
    />
  </section>
</BaseLayout>
