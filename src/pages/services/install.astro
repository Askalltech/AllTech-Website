---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/lib/site';
import { buildBreadcrumbSchema } from '~/lib/schema';
import { Services21, type Services21Item } from '@/components/services21';

/**
 * PARENT LANDING PAGE for the Install menu column.
 *
 * DEVIATION FROM THE SUPPLIED BRIEF, deliberate: the brief retargets every nav
 * child onto an anchor on this page (#unifi, #cameras, #helpdesk, ...). Those
 * children already have full standalone pages on this branch, built and
 * approved earlier. Pointing the nav back at anchors would orphan thirteen
 * pages, so the nav children are left alone and each capability block here
 * links OUT to its page instead.
 *
 * The anchor ids the brief specifies ARE present on this page, so if the nav
 * should later point at anchors instead, that switch costs one edit in
 * menu.ts and nothing here changes.
 */

const capabilities: Services21Item[] = [
  {
    id: '01',
    anchorId: 'cameras',
    title: 'Security Cameras',
    href: '/services/security-cameras',
    icon: 'Camera',
    description:
      'UniFi Protect indoor and outdoor camera systems, designed around the shots you actually need. On-premise recording with retention sized to your policy, remote viewing without opening ports, and placement planned with lighting and identification distance in mind.',
    image: '/services/security-cameras-tile.webp',
    photoCredit: { name: 'Miłosz Klinowski', url: 'https://unsplash.com/photos/two-grey-cctv-cameras-BW0d0IllW8E' },
  },
  {
    id: '02',
    anchorId: 'access',
    title: 'Door Access Control',
    href: '/services/door-access-control',
    icon: 'KeyRound',
    description:
      'UniFi Access readers with card, fob, and mobile unlock — no more re-keying after every departure. Schedules and per-door permissions by role, an audit trail of who opened what and when, and integration with your identity system so offboarding removes building access too.',
    image: '/services/door-access-control-tile.webp',
    photoCredit: { name: 'Jakub Żerdzicki', url: 'https://unsplash.com/photos/an-empty-room-with-stairs-and-a-door-36K2PZYNfcM' },
  },
  {
    id: '03',
    anchorId: 'cabling',
    title: 'Structured Cabling',
    href: '/services/structured-cabling',
    icon: 'Cable',
    description:
      'Cat6/6A drops, terminations, and labeling done to standard — tested, certified, and documented. Fiber runs between buildings and floors where copper won\'t reach, with clean pathways and dressing because someone will have to work in there in five years.',
    image: '/services/structured-cabling-tile.webp',
    photoCredit: { name: 'Kier in Sight Archives', url: 'https://unsplash.com/photos/a-bunch-of-black-wires-are-stacked-together-EYAfw1ujabI' },
  },
  {
    id: '04',
    anchorId: 'ptp',
    title: 'Point-to-Point Wireless',
    href: '/services/point-to-point-wireless',
    icon: 'Radio',
    description:
      'Licence-free point-to-point and point-to-multipoint links bridging buildings, yards, shops, and remote sites where trenching isn\'t worth it. Path survey and link budget confirmed before install, monitored alongside the rest of the network so a degrading link gets caught before it drops.',
    image: '/services/point-to-point-wireless-tile.webp',
    photoCredit: { name: 'Tony Stoddard', url: 'https://unsplash.com/photos/gray-metal-tower-with-accessories-DgZxBnZeQo8' },
  },
  {
    id: '05',
    anchorId: 'racks',
    title: 'Rack & Server Rooms',
    href: '/services/rack-server-rooms',
    icon: 'Server',
    description:
      'Rack and enclosure buildouts: mounting, power, cable management, and airflow. Cleanup of inherited server rooms — re-terminated, re-labeled, and mapped — plus UPS sizing and shutdown configuration so a power event doesn\'t corrupt what\'s running.',
    image: '/services/rack-server-rooms-tile.webp',
    photoCredit: { name: 'Tyler', url: 'https://unsplash.com/photos/a-rack-of-electronic-equipment-in-a-dark-room-OnI_TNcIv9U' },
  },
  {
    id: '06',
    anchorId: 'fiber',
    title: 'Fiber Optic',
    href: '/services/fiber-optic',
    icon: 'Zap',
    description:
      'Single-mode and multimode fiber installation for building-to-building and campus links. Fusion splicing — clean, low-loss splices, not mechanical connectors as a shortcut — with every run OTDR- and power-meter-tested and results handed over as a file.',
    image: '/services/fiber-optic-tile.webp',
    photoCredit: { name: 'JJ Ying', url: 'https://unsplash.com/photos/purple-and-blue-light-digital-wallpaper-8bghKxNU1j0' },
  },
  {
    id: '07',
    anchorId: 'cleaning',
    title: 'Network & IoT Cleaning',
    href: '/services/network-iot-cleaning',
    icon: 'Sparkles',
    description:
      'Physical cleaning and inspection for switches, access points, cameras, and door readers. Housings, vents, and lenses cleaned so airflow and image quality stay where they should be — catching dust and debris before it turns into a service call.',
    image: '/services/network-iot-cleaning-tile.webp',
    photoCredit: { name: 'Ivan N', url: 'https://unsplash.com/photos/a-bunch-of-wires-and-wires-in-a-room-AfStyhXC5kM' },
  },
];

const pillars: [string, string][] = [
  ['In-house', 'Our engineers on the ladder, not a subcontracted crew.'],
  ['Integrated', 'Cameras and doors land on the VLANs we designed.'],
  ['Documented', 'As-built drawings, port maps, and labels handed over at close.'],
];

const engage: [string, string, string, string][] = [
  ['01', 'WALK', 'Site walk & scope', 'On-site visit, measurements, photos, and a fixed-scope quote.'],
  ['02', 'INSTALL', 'Build & terminate', 'Scheduled around your hours; tested and certified before we call it done.'],
  ['03', 'HAND OFF', 'Document & support', 'As-builts delivered, systems added to monitoring, warranty and support in writing.'],
];

const contactHref = '/contact?service=Network%20%26%20Infrastructure';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Low-Voltage Install — Cameras, Access Control & Cabling',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.serviceArea.map((l) => `${l.city}, ${l.region}`),
  name: 'Low-Voltage Install — Cameras, Access Control & Cabling',
  description: 'On-site low-voltage installation across northern Utah: UniFi Protect cameras, door access control, structured cabling, point-to-point wireless, and server-room buildouts.',
};

const breadcrumbEntries = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Install', path: '/services/install' },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbEntries);
---

<BaseLayout
  breadcrumbs={breadcrumbEntries}
  title="Low-Voltage Install — Cameras, Access & Cabling"
  description="On-site low-voltage installation across northern Utah: UniFi Protect cameras, door access control, structured cabling, point-to-point wireless, and server-room buildouts."
  canonical={`${site.url}/services/install`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <!-- Hero -->
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="eyebrow mb-4">Install &middot; On-site &amp; Low-Voltage</div>
        <h1 class="font-display text-5xl lg:text-6xl font-semibold leading-[0.95] tracking-tight">
          The part that<br />
          <span style="color: var(--color-amber-400);">requires a ladder.</span>
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-muted">Cameras, door access, cabling, wireless bridges, and rack buildouts — installed by the same engineers who manage the network they plug into. One vendor, one drawing, one number to call.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contactHref} class="btn btn-primary">Schedule a site walk <span aria-hidden="true">&rarr;</span></a>
          <a href="#what-we-deploy" class="btn btn-ghost">What we install</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="what-we-deploy" class="surface-dark py-16 lg:py-20 scroll-mt-24" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-4">Capabilities</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          What we install.
        </h2>
        <p class="mt-4 text-muted leading-relaxed">Seven on-site disciplines. Each one lands on the network we designed, so there's no finger-pointing between the cabling guy and the IT guy.</p>
      </div>
    </div>
    <Services21 services={capabilities} client:visible />
  </section>

  <!-- Our Approach — supplied verbatim by the install team manager. -->
  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-prose">
      <div class="mb-10">
        <div class="eyebrow mb-4">Our Approach</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          Built to last, not just to look right.
        </h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-muted">
        <p>
          We take a coordinated, professional approach to every project, working alongside all
          required trades to ensure a seamless and high-quality result from start to finish. Our
          team specializes in structured cabling, network infrastructure, fiber optic installation,
          surveillance systems, and all related low-voltage solutions.
        </p>
        <p>
          A well-built network goes beyond appearance. While clean, organized rack installations are
          part of our standard, we focus on delivering reliable, scalable systems that support
          long-term performance, uptime, and growth.
        </p>
        <p>
          We also recognize that proper planning is critical. Not every space is suited for network
          infrastructure, and we provide guidance early in the process to help ensure the environment
          supports the equipment being installed.
        </p>
        <p>
          When upgrades or reorganizations are needed, we plan carefully to minimize disruption,
          coordinating scheduling and staging to keep downtime as limited as possible.
        </p>
        <p>
          Our goal is to deliver solutions that make sense for your environment and lifecycle —
          maintaining what works, improving what's needed, and ensuring every component is clearly
          documented and built to last.
        </p>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-4">Why AllTech</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          One crew, one drawing.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {pillars.map(([t, b]) => (
          <div>
            <div class="font-display text-2xl font-semibold" style="color: var(--color-amber-500);">{t}</div>
            <div class="mt-2 leading-relaxed text-muted">{b}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engage -->
  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-4">How we engage</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          Three ways to start.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {engage.map(([n, label, t, b], i) => (
          <div class="card-feature-tile group relative overflow-hidden text-left" style={i === 1 ? 'border: 1px solid var(--color-amber-400);' : ''}>
            <div class="card-spotlight-text" aria-hidden="true"></div>
            <div class="font-mono text-xs mb-2 tracking-wider" style="color: var(--color-amber-600);">{n} &middot; {label}</div>
            <h3 class="font-display text-xl font-semibold mb-3" style="color: var(--color-text-primary);">{t}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-default);">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="surface-dark py-16 lg:py-24" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          Building out, moving in, or fixing what&rsquo;s already there?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">Tell us the site and what you need covered. We'll walk it and come back with a real number.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contactHref} class="btn btn-primary">Schedule a site walk <span aria-hidden="true">&rarr;</span></a>
          <a href={`tel:${site.phoneE164}`} class="btn btn-ghost font-mono">{site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
