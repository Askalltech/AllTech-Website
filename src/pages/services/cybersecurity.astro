---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/lib/site';
import { buildBreadcrumbSchema } from '~/lib/schema';
import { Services21, type Services21Item } from '@/components/services21';
import { SonicWaveformHero } from '@/components/ui/sonic-waveform';

const capabilities: Services21Item[] = [
  {
    id: '01',
    anchorId: 'top10',
    title: 'AllTech Top 10',
    href: '/services/alltech-top-10',
    icon: 'ListChecks',
    image: '/services/alltech-top-10-tile.webp',
    ctaLabel: 'AllTech Top 10',
    description: [
      'A pre-selected set of essential security controls for small and mid-sized businesses, mapped to CIS Controls and NIST CSF.',
      'Continually refined as new threats emerge — not a static checklist from a compliance binder.',
      'The starting baseline we recommend before scoping anything more specialized below.',
    ],
  },
  {
    id: '02',
    anchorId: 'endpoint',
    title: 'Endpoint Security',
    href: '/services/endpoint-security',
    icon: 'ShieldCheck',
    image: '/services/endpoint-security-tile.webp',
    photoCredit: { name: 'Aakash Dhage', url: 'https://unsplash.com/photos/a-large-group-of-black-chairs-LEJc0kZHaAQ' },
    ctaLabel: 'Endpoint Security & Managed EDR',
    description: [
      'EDR deployed and monitored across workstations and servers via Datto RMM — real-time threat detection, not signature-only antivirus.',
      'Automated isolation of compromised endpoints during active incidents.',
      'Patch management and vulnerability remediation on the same platform — security and maintenance aren\'t separate tools.',
    ],
  },
  {
    id: '03',
    anchorId: 'email',
    title: 'Email Security',
    href: '/services/email-security',
    icon: 'Mail',
    ctaLabel: 'Email Security & Phishing Protection',
    description: [
      'Advanced filtering in front of Microsoft 365 and Google Workspace — catches phishing, BEC, and malware before delivery.',
      'Mailbox security audits via Exchange Online PowerShell: risky forwarding rules, legacy auth, suspicious sign-ins.',
      'Deliverable via Cloudflare Email Security as part of a Zero Trust deployment, or as a standalone layer.',
    ],
  },
  {
    id: '04',
    anchorId: 'ndr',
    title: 'Network Detection & Response',
    href: '/services/network-detection',
    icon: 'Radar',
    ctaLabel: 'Network Detection & Response',
    description: [
      'AI-driven Network Detection & Response (NDR) — learns the normal pattern of life for your network and flags deviations, not just known signatures.',
      'We actively tune detection policies across multiple client environments, cutting false positives while keeping real threats blocked.',
      'Catches lateral movement and C2 traffic that signature-based tools miss entirely.',
    ],
  },
  {
    id: '05',
    anchorId: 'soc',
    title: 'Managed SOC',
    href: '/services/managed-soc',
    icon: 'Eye',
    ctaLabel: 'Managed SOC & 24/7 Monitoring',
    description: [
      '24/7 monitoring across endpoint, network, and email signals.',
      'Alerts triaged by engineers who know your environment — not a generic offshore SOC reading from a playbook.',
      'Integrated with the same tools used for IR, so when something gets flagged, the same team that\'s been watching it can respond immediately.',
    ],
  },
  {
    id: '06',
    anchorId: 'pentest',
    title: 'Penetration Testing',
    href: '/services/penetration-testing',
    icon: 'Target',
    ctaLabel: 'Penetration Testing',
    description: [
      'Conducted via vPenTest — external, internal, and web application testing.',
      'Plain-English reports: findings grouped by severity (Critical / High / Medium / Low), each with a concrete remediation note.',
      'Designed as a recurring program, not a one-time checkbox — year-over-year trend tracking shows whether the environment is actually getting more secure.',
      'Recent engagements include multi-site businesses with office and OT network segments.',
    ],
  },
  {
    id: '07',
    anchorId: 'ir',
    title: 'Incident Response',
    href: '/services/incident-response',
    icon: 'Siren',
    ctaLabel: 'Incident Response & Breach Containment',
    description: [
      'Active investigation and containment — not just "restore from backup and hope."',
      'Malware analysis, PowerShell-based collection and eradication scripting deployed via RMM at scale, identification and removal of persistence mechanisms.',
      'Experience eradicating multi-system C2 compromises while keeping the business running.',
      'Every engagement includes a written summary: what happened, what we did, what changes prevent recurrence.',
    ],
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Managed Cybersecurity Services',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.serviceArea.map((l) => `${l.city}, ${l.region}`),
  name: 'Cybersecurity Services',
  description: 'AllTech provides managed cybersecurity for businesses in northern Utah — EDR, email security, AI-driven network detection (NDR), 24/7 SOC monitoring, penetration testing, and incident response.',
};

const breadcrumbEntries = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Cybersecurity', path: '/services/cybersecurity' },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbEntries);
---

<BaseLayout
  breadcrumbs={breadcrumbEntries}
  title="Cybersecurity Services"
  description="AllTech provides managed cybersecurity for businesses in northern Utah — EDR, email security, AI-driven network detection, 24/7 SOC monitoring, penetration testing, and incident response."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <!-- Hero -->
  <section class="surface-dark relative overflow-hidden">
    <SonicWaveformHero
      client:visible
      eyebrow="Cybersecurity · Managed Security Services"
      title="Security run by engineers who"
      highlightedTitle="know your environment."
      description="EDR, email filtering, AI-driven network detection, 24/7 SOC monitoring, penetration testing, and incident response — operated by the same team that handles your day-to-day IT. No handoffs to a generic security vendor. No context lost."
      primaryCtaLabel="Scope an engagement"
      primaryCtaHref="/contact?service=cybersecurity"
      secondaryCtaLabel="What's included"
      secondaryCtaHref="#what-we-deploy"
      className="min-h-[560px] py-16 lg:py-20"
    />
  </section>

  <!-- What we deploy — capability grid with anchor IDs -->
  <section id="what-we-deploy" class="surface-dark py-20 lg:py-24" style="border-top: 1px solid var(--color-line-faint);">
    <Services21 services={capabilities} client:visible />
  </section>

  <!-- Why us -->
  <section class="surface-light py-20 lg:py-24">
    <div class="container-wide">
      <div class="max-w-3xl">
        <div class="eyebrow mb-3">Why AllTech for Cybersecurity</div>
        <h2 class="text-4xl font-semibold leading-tight">
          Not a reseller. Not a silo.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          NDR tuning, EDR monitoring, email audits, and penetration testing are run
          by the same engineers who handle your day-to-day IT. Security context carries
          over — we already know which servers matter, which users are high-risk, and
          which parts of your network you can't afford to take down.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {[
          {
            stat: 'Integrated',
            label: 'SOC, EDR, and IR are operated by the same team — no handoffs, no lost context between security and IT.',
          },
          {
            stat: 'In-house',
            label: 'EDR monitoring, email security, and incident response are delivered by our own engineers — never subcontracted to a faceless NOC.',
          },
          {
            stat: 'Local',
            label: 'Rooted in Northern Utah since 2009 — the same team that runs your day-to-day IT, on-site wherever you need us.',
          },
        ].map(({ stat, label }) => (
          <div>
            <div class="font-display text-3xl font-semibold" style="color: var(--color-amber-500);">{stat}</div>
            <div class="mt-2 leading-relaxed text-muted">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we engage -->
  <section class="surface-dark py-20 lg:py-24">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-3">How we engage</div>
        <h2 class="text-4xl font-semibold leading-tight">Three ways to start.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        {[
          {
            n: '01',
            label: 'ASSESS',
            title: 'Security Assessment / Pentest',
            body: 'A vPenTest engagement or full posture review. Often the right first step for a business that\'s never had an outside look at their security.',
          },
          {
            n: '02',
            label: 'DEPLOY',
            title: 'Harden & Implement',
            body: 'Rolling out EDR, email security, network detection, and closing the gaps found in the assessment. Fixed-scope; timeline depends on environment size.',
            highlight: true,
          },
          {
            n: '03',
            label: 'OPERATE',
            title: 'Managed SOC',
            body: 'Ongoing 24/7 monitoring, alert triage, quarterly pentests, and incident response retainer. Billed monthly per endpoint/user.',
          },
        ].map(({ n, label, title, body, highlight }) => (
          <div class="card" style={highlight ? 'border-color: var(--color-amber-400);' : ''}>
            <div class="font-mono text-xs mb-2 tracking-wider" style="color: var(--color-amber-300);">{n} · {label}</div>
            <h3 class="font-display text-xl font-semibold mb-3">{title}</h3>
            <p class="text-sm text-muted leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="surface-dark py-20 lg:py-24">
    <div class="container-wide">
      <div class="rounded-xl p-10 lg:p-14 grid lg:grid-cols-12 gap-8 items-center relative overflow-hidden"
           style="background: linear-gradient(135deg, var(--color-surface-1), var(--color-surface-2)); border: 1px solid var(--color-line-soft);">
        <div class="glow-amber" style="top: -300px; left: -150px; width: 500px; height: 500px;"></div>
        <div class="lg:col-span-8 relative">
          <h2 class="font-display text-3xl lg:text-4xl font-semibold leading-tight">Ready to find out where you actually stand?</h2>
          <p class="mt-4 text-lg max-w-2xl text-muted">
            Send us a short note about your environment. We'll book a 30-minute call,
            talk through your exposure, and tell you honestly what's worth doing first.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-wrap gap-3 lg:justify-end relative">
          <a href="/contact?service=cybersecurity" class="btn btn-primary">Start a conversation</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
