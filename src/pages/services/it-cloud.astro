---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/lib/site';
import { buildBreadcrumbSchema } from '~/lib/schema';
import { Services21, type Services21Item } from '@/components/services21';

/**
 * PARENT LANDING PAGE for the IT & Cloud menu column.
 *
 * DEVIATION FROM THE SUPPLIED BRIEF, deliberate: the brief retargets every nav
 * child onto an anchor on this page (#unifi, #cameras, #helpdesk, ...). Those
 * children already have full standalone pages on this branch, built and
 * approved earlier. Pointing the nav back at anchors would orphan thirteen
 * pages, so the nav children are left alone and each capability block here
 * links OUT to its page instead.
 *
 * The anchor ids the brief specifies ARE present on this page, so if the nav
 * should later point at anchors instead, that switch costs one edit in
 * menu.ts and nothing here changes.
 */

const capabilities: Services21Item[] = [
  {
    id: '01',
    anchorId: 'remote-support',
    title: 'Remote IT Support',
    href: '/remote-it-support',
    icon: 'Headset',
    image: '/services/remote-support-tile.webp',
    photoCredit: { name: 'Hongjin Wang', url: 'https://unsplash.com/photos/Mh5l18Ndc-o' },
    description: [
      'Help desk, monitoring, cybersecurity, Microsoft 365, and backup — all deliverable without anyone on-site.',
      'Company-managed devices supported the same way wherever your team works, secured through Zero Trust Access.',
      'Distributed and multi-location teams held to one standard, including sites with no on-site IT staff.',
    ],
  },
  {
    id: '02',
    anchorId: 'helpdesk',
    title: 'Help Desk',
    href: '/services/help-desk',
    icon: 'LifeBuoy',
    image: '/services/helpdesk-tile.webp',
    photoCredit: { name: 'Arjan Pradhan', url: 'https://unsplash.com/photos/FSOhw8bTCzM' },
    description: [
      'Local engineers answering the phone in Hyde Park — not a ticket queue routed overseas.',
      'Remote resolution for most issues, on-site when hardware needs hands.',
      'Onboarding and offboarding handled end to end: laptop, logins, M365, access, and the reverse on the way out.',
    ],
  },
  {
    id: '03',
    anchorId: 'rmm',
    title: 'Remote Monitoring & Patching',
    href: '/services/remote-monitoring',
    icon: 'Activity',
    image: '/services/rmm-tile.webp',
    photoCredit: { name: 'Ronan Furuta', url: 'https://unsplash.com/photos/0J-1dN3MwCM' },
    description: [
      'Datto RMM across workstations and servers — patching, scripting, and automation running before problems surface.',
      'Health alerting on disks, backups, and services, so a silent failure doesn\'t become a Monday morning.',
      'Standardized configuration applied to every machine, so the fleet stays consistent as it grows.',
    ],
  },
  {
    id: '04',
    anchorId: 'vendors',
    title: 'Vendor Management',
    href: '/services/vendor-management',
    icon: 'Handshake',
    image: '/services/vendors-tile.webp',
    photoCredit: { name: 'Hongjin Wang', url: 'https://unsplash.com/photos/tYeDOOJpIVE' },
    description: [
      'One number for the ISP, the phone system, the line-of-business software, and the copier.',
      'We sit on the hold call and translate, so your staff doesn\'t have to.',
      'Renewal and contract dates tracked, so nothing auto-renews by surprise.',
    ],
  },
  {
    id: '05',
    anchorId: 'm365',
    title: 'Microsoft 365',
    href: '/services/cloud-microsoft-365',
    icon: 'Cloud',
    image: '/services/m365-tile.webp',
    photoCredit: { name: 'Ricardo Gomez Angel', url: 'https://unsplash.com/photos/UD5drKd4H6w' },
    description: [
      'Tenant design, licensing right-sizing, and migration from on-prem Exchange, Google Workspace, or another tenant.',
      'SharePoint and Teams structure that matches how your teams actually share files.',
      'Ongoing administration and security baseline maintenance.',
    ],
  },
  {
    id: '06',
    anchorId: 'intune',
    title: 'Entra ID & Intune',
    href: '/services/entra-id-intune',
    icon: 'Fingerprint',
    image: '/services/intune-tile.webp',
    photoCredit: { name: 'Kashish Lamba', url: 'https://unsplash.com/photos/DGwunSOMMbk' },
    description: [
      'Identity as the control plane: MFA, conditional access, and least-privilege roles.',
      'Intune device enrollment, compliance policy, and app deployment across Windows and mobile.',
      'Access that follows the person, so a departure closes every door at once.',
    ],
  },
  {
    id: '07',
    anchorId: 'bdr',
    title: 'Backup & Disaster Recovery',
    href: '/services/backup-disaster-recovery',
    icon: 'HardDriveDownload',
    image: '/services/bdr-tile.webp',
    photoCredit: { name: 'Dominika Körtvélyesiová', url: 'https://unsplash.com/photos/SjZi9gy2MzI' },
    description: [
      'Immutable backup copies that ransomware can\'t reach or encrypt.',
      'Restores tested on a schedule — a backup nobody has restored is a hope, not a plan.',
      'Documented recovery objectives, so you know what "back up and running" actually means in hours.',
    ],
  },
  {
    id: '08',
    anchorId: 'data-recovery',
    title: 'Utah Data Recovery',
    href: '/services/utah-data-recovery',
    icon: 'HardDrive',
    image: '/services/data-recovery-tile.webp',
    photoCredit: { name: 'Ricardo Gomez Angel', url: 'https://unsplash.com/photos/C34zrJeT6lk' },
    description: [
      'Recovery for failed hard drives, SSDs, RAID and NAS arrays, and phones.',
      'Digital forensic analysis available for civil and criminal cases.',
      'No data, no charge — you don\'t pay if we can\'t recover it.',
    ],
  },
];

const pillars: [string, string][] = [
  ['Local', 'Rooted in Northern Utah since 2009, on-site when it matters.'],
  ['Proactive', 'Monitored and patched before the call comes in.'],
  ['Accountable', 'Documented, responsive, and still here in year ten.'],
];

const engage: [string, string, string, string][] = [
  ['01', 'ASSESS', 'Environment review', 'Inventory, risk, and licensing review. Often the first step for a business outgrowing one IT person.'],
  ['02', 'STANDARDIZE', 'Onboard & align', 'RMM, identity, M365, and backup brought to one standard; fixed scope.'],
  ['03', 'OPERATE', 'Managed agreement', 'Help desk, monitoring, patching, and vendor management billed monthly per user or endpoint.'],
];

const contactHref = '/contact?service=Managed%20IT';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Managed IT & Cloud Services',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.serviceArea.map((l) => `${l.city}, ${l.region}`),
  name: 'Managed IT & Cloud Services',
  description: 'Outsourced IT for northern Utah businesses: local help desk, Datto RMM monitoring and patching, vendor management, Microsoft 365, Entra ID and Intune, and tested backup and disaster recovery.',
};

const breadcrumbEntries = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'IT & Cloud', path: '/services/it-cloud' },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbEntries);
---

<BaseLayout
  breadcrumbs={breadcrumbEntries}
  title="Managed IT & Cloud Services"
  description="Outsourced IT for northern Utah businesses: local help desk, Datto RMM monitoring and patching, vendor management, Microsoft 365, Entra ID and Intune, and tested backup and disaster recovery."
  canonical={`${site.url}/services/it-cloud`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <!-- Hero -->
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="eyebrow mb-4">IT &amp; Cloud &middot; Managed Services</div>
        <h1 class="font-display text-5xl lg:text-6xl font-semibold leading-[0.95] tracking-tight">
          Your IT department,<br />
          <span style="color: var(--color-amber-400);">without the hiring.</span>
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-muted">Help desk, monitoring, patching, Microsoft 365, identity, and backup — run by local engineers who already know your environment. When you call, you get the person who built it.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contactHref} class="btn btn-primary">Talk to an engineer <span aria-hidden="true">&rarr;</span></a>
          <a href="#what-we-deploy" class="btn btn-ghost">What's included</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="what-we-deploy" class="surface-dark py-16 lg:py-20 scroll-mt-24" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-4">Capabilities</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          What's included.
        </h2>
        <p class="mt-4 text-muted leading-relaxed">Eight functions that normally take an internal team. Each links to how we actually deliver it.</p>
      </div>
    </div>
    <Services21 services={capabilities} client:visible />
  </section>

  <!-- Why -->
  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-4">Why AllTech</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          One team, no hand-offs.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {pillars.map(([t, b]) => (
          <div>
            <div class="font-display text-2xl font-semibold" style="color: var(--color-amber-500);">{t}</div>
            <div class="mt-2 leading-relaxed text-muted">{b}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engage -->
  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-2xl mb-12">
        <div class="eyebrow mb-4">How we engage</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          Three ways to start.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {engage.map(([n, label, t, b], i) => (
          <div class="card" style={i === 1 ? 'border-color: var(--color-amber-400);' : ''}>
            <div class="font-mono text-xs mb-2 tracking-wider" style="color: var(--color-amber-600);">{n} &middot; {label}</div>
            <h3 class="font-display text-xl font-semibold mb-3" style="color: var(--color-text-primary);">{t}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-default);">{b}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-3xl leading-relaxed text-muted">
        Related: <a href="/services/cybersecurity" class="font-medium" style="color: var(--color-amber-600);">Cybersecurity</a> &middot;
        <a href="/services/alltech-top-10" class="font-medium" style="color: var(--color-amber-600);">AllTech Top 10</a> &middot;
        <a href="/assessment" class="font-medium" style="color: var(--color-amber-600);">Free security gap assessment</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="surface-dark py-16 lg:py-24" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
          Outgrowing one IT person?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">Send a short note about your environment. We'll book 30 minutes and tell you honestly what's worth doing first.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contactHref} class="btn btn-primary">Talk to an engineer <span aria-hidden="true">&rarr;</span></a>
          <a href={`tel:${site.phoneE164}`} class="btn btn-ghost font-mono">{site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
