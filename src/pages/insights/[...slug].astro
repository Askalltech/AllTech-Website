---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { site } from '~/lib/site';
import { buildBreadcrumbSchema } from '~/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await post.render();

const articleUrl = `${site.url}/insights/${post.slug}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  author: { '@type': 'Organization', name: post.data.author },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  // image / publisher / mainEntityOfPage were missing — Google treats the
  // first two as required for Article rich results.
  image: `${site.url}${post.data.heroImage ?? '/logo.webp'}`,
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
};
const breadcrumbEntries = [
  { name: 'Home', path: '/' },
  { name: 'Insights', path: '/insights' },
  { name: post.data.title, path: `/insights/${post.slug}` },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbEntries);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  ogType="article"
  articlePublishedTime={post.data.pubDate.toISOString()}
  articleModifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  articleAuthor={post.data.author}
  breadcrumbs={breadcrumbEntries}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <article class="surface-dark py-16">
    <div class="container-prose">
      <a href="/insights" class="text-sm font-medium" style="color: var(--color-amber-300);">← Back to insights</a>
      <header class="mt-6 mb-10">
        <div class="text-xs font-mono mb-4" style="color: var(--color-amber-300);">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
        </div>
        <h1 class="font-display text-4xl lg:text-5xl font-semibold leading-tight">{post.data.title}</h1>
        <p class="mt-4 text-xl leading-relaxed text-muted">{post.data.description}</p>
      </header>

      {post.data.heroImage && (
        <div class="relative mb-10 rounded-xl overflow-hidden">
          <img src={post.data.heroImage} alt={post.data.title} class="w-full h-auto object-cover" />
          {post.data.heroImageCredit && (
            <a
              href={post.data.heroImageCredit.url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="absolute top-2 left-2 z-10 rounded px-1.5 py-0.5 text-[10px] leading-none text-white/70 transition hover:text-white"
              style="background: rgba(0,0,0,0.35);"
            >
              Photo: {post.data.heroImageCredit.name}
            </a>
          )}
        </div>
      )}

      <div class="prose-alltech"><Content /></div>
    </div>
  </article>
</BaseLayout>
