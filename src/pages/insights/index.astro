---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Blog1 } from '~/components/blog1';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const gridPosts = posts.map((post) => ({
  id: post.slug,
  title: post.data.title,
  summary: post.data.description,
  label: post.data.tags[0] ?? 'Insights',
  href: `/insights/${post.slug}`,
  image: post.data.heroImage,
}));
---

<BaseLayout
  title="Insights"
  description="Technical writing from the AllTech engineering team — Cloudflare deployments, incident response, network design, and more."
>
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="eyebrow mb-4">Insights</div>
      <h1 class="font-display text-5xl lg:text-6xl font-semibold leading-tight max-w-3xl">
        Field notes from the <span style="color: var(--color-amber-400);">engineering team</span>.
      </h1>
    </div>
  </section>

  {posts.length === 0 ? (
    <section class="surface-dark py-16">
      <div class="container-prose">
        <p class="text-lg text-muted">Posts coming soon. In the meantime, follow us for updates.</p>
      </div>
    </section>
  ) : (
    <Blog1 posts={gridPosts} client:visible />
  )}
</BaseLayout>
