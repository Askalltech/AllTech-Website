---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { EvervaultCardDemo } from '~/components/EvervaultCardDemo';

/**
 * Isolated demo for the shadcn/Aceternity "Evervault" card
 * (src/components/ui/evervault-card.tsx) — the cursor-following mask that
 * reveals a field of random characters behind a radial gradient glow.
 *
 * Lives under /draft/ on purpose: that path is excluded from the sitemap
 * (astro.config.mjs filter) and Disallowed in robots.txt.ts, so this preview
 * page is reachable by direct URL for review but never indexed. Delete it, or
 * lift the effect into a real surface, once the placement is decided.
 *
 * The React island is hydrated with client:load because the whole point is the
 * pointermove interaction — it must run on the client immediately.
 */
---

<BaseLayout
  title="Evervault card demo"
  description="Internal component demo — not for indexing."
  noindex
>
  <section class="container-wide py-20 lg:py-28">
    <div class="mb-10 max-w-2xl">
      <div class="eyebrow mb-3">Component demo</div>
      <h1 class="font-display text-3xl lg:text-4xl font-bold" style="color: var(--color-text-primary)">
        Evervault card
      </h1>
      <p class="mt-3 text-lg leading-relaxed" style="color: var(--color-text-default)">
        Hover the card below. The cursor reveals a gradient-lit field of
        random characters through a radial mask — the original Aceternity
        effect, integrated as a React island.
      </p>
    </div>
    <EvervaultCardDemo client:load />
  </section>
</BaseLayout>
