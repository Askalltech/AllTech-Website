---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CaseStudies10 } from '~/components/case-studies10';
---

<BaseLayout
  title="Case Studies"
  description="How AllTech delivers cybersecurity, Cloudflare Zero Trust, and managed IT projects for real businesses across northern Utah."
>
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="eyebrow mb-4">Case Studies</div>
      <h1 class="font-display text-5xl lg:text-6xl font-semibold leading-tight max-w-3xl">
        Real projects, <span style="color: var(--color-amber-400);">real outcomes</span>.
      </h1>
    </div>
  </section>

  <!-- shadcnblocks case-studies10: horizontal carousel. Wired to its own
       default (fictional companies, stock CDN photos) rather than the real
       caseStudies collection — that collection is empty right now, so
       there's nothing real to show yet. Swap `items` for real client
       stories/logos/photos as they're written. -->
  <section>
    <CaseStudies10
      title="Real projects, real outcomes."
      description="A closer look at a few of the projects we've delivered — swap for real client stories, logos, and photos as they're written."
      client:visible
    />
  </section>
</BaseLayout>
