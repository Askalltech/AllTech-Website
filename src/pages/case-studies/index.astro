---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CaseStudies10 } from '~/components/case-studies10';

// Driven by the real caseStudies collection. This page previously rendered
// CaseStudies10's own defaults — six fabricated companies with dead links and
// stock photography — which meant the site published invented client outcomes
// as if they were real work. Those defaults are gone; until the collection has
// entries, this renders an honest empty state instead.
const entries = await getCollection('caseStudies');
const studies = entries.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const items = studies.map((entry) => ({
  id: entry.slug,
  logo: '/logo.webp',
  logoAlt: entry.data.client,
  title: entry.data.title,
  description: entry.data.summary,
  href: `/case-studies/${entry.slug}`,
  image: entry.data.heroImage ?? '/logo.webp',
}));
---

<BaseLayout
  title="Case Studies"
  description="How AllTech delivers cybersecurity, Cloudflare Zero Trust, and managed IT projects for real businesses across northern Utah."
>
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="eyebrow mb-4">Case Studies</div>
      <h1 class="font-display text-5xl lg:text-6xl font-semibold leading-tight max-w-3xl">
        Real projects, <span style="color: var(--color-amber-400);">real outcomes</span>.
      </h1>
    </div>
  </section>

  {items.length === 0 ? (
    <section class="surface-dark py-16">
      <div class="container-prose">
        <h2 class="font-display text-2xl font-semibold mb-3">Written case studies are on the way.</h2>
        <p class="text-lg text-muted leading-relaxed">
          We're writing up recent engagements — multi-site Zero Trust rollouts,
          incident response, and network builds — with our clients' sign-off before
          anything gets published. In the meantime, we're happy to talk through
          comparable work directly.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Ask about similar projects</a>
          <a href="/insights" class="btn btn-ghost">Read our insights</a>
        </div>
      </div>
    </section>
  ) : (
    <section>
      <CaseStudies10
        title={undefined}
        description="A closer look at projects we've delivered for businesses across northern Utah."
        items={items}
        client:visible
      />
    </section>
  )}
</BaseLayout>
