---
import BaseLayout from '~/layouts/BaseLayout.astro';

/**
 * Our Team — one large group photo plus a short summary, instead of
 * individual bios/headshots.
 *
 * TO ADD THE PHOTO: drop the file in /public/team/ (e.g.
 * "/team/group-photo.jpg") and set `groupPhoto` below. Until then, the
 * frame renders a placeholder so the layout is correct in the meantime.
 */
const groupPhoto: string | undefined = undefined; // e.g. '/team/group-photo.jpg'
---

<BaseLayout
  title="Our Team"
  description="Meet the team behind AllTech — the engineers and technicians who design, deploy, and run IT, cybersecurity, and network infrastructure in Northern Utah."
>
  <section class="surface-dark relative overflow-hidden">
    <div class="relative container-wide py-16 lg:py-20">
      <div class="eyebrow mb-4">Our Team</div>
      <h1 class="font-display text-5xl lg:text-6xl font-bold leading-tight max-w-3xl">
        The people who <span style="color: var(--color-amber-400);">build and care about</span> your infrastructure.
      </h1>
      <p class="mt-6 text-xl max-w-2xl leading-relaxed text-muted">
        Real engineers, local since 2009. When you call AllTech, you reach the
        same people who designed your network.
      </p>
    </div>
  </section>

  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div
          class="rounded-2xl overflow-hidden aspect-[4/3]"
          style="border: 1px solid var(--color-line-soft); background: var(--color-bg-tint);"
        >
          {groupPhoto ? (
            <img src={groupPhoto} alt="The AllTech team" class="w-full h-full object-cover" loading="lazy" />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-sm text-subtle">
              Team photo coming soon
            </div>
          )}
        </div>

        <div>
          <div class="eyebrow mb-4">Meet the team</div>
          <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight mb-6" style="color: var(--color-text-primary);">
            A tight-knit crew of engineers, technicians, and support staff.
          </h2>
          <p class="text-lg leading-relaxed text-muted">
            AllTech is a team of network engineers, cybersecurity specialists, and
            support technicians based in Northern Utah. Everyone here designs,
            deploys, and maintains the systems we support — when you call, you're
            talking to someone who already knows your environment, not a call
            center reading from a script.
          </p>
          <a href="/contact" class="btn btn-primary mt-8">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Culture/personality section. Deliberately kept separate from the
       "Meet the team" block above: that one carries the value proposition
       (you reach the engineer who built your environment), this one is who
       we actually are. Copy supplied verbatim by the team — split into
       paragraphs for readability, wording unchanged. -->
  <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
    <div class="container-wide">
      <div class="max-w-3xl">
        <div class="eyebrow mb-4">Who we are</div>
        <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight mb-8" style="color: var(--color-text-primary);">
          This is us.
        </h2>

        <div class="space-y-5 text-lg leading-relaxed text-muted">
          <p>
            We're a bunch of nerds, and we are unashamed (although perhaps we should
            be, slightly). Some of us get more excited about going to SAINTCON than a
            child going on a first trip to Disneyland. Yes, some of the IT stereotypes
            are true: there are plenty of gamers and hardcore sci-fi fans among us.
          </p>
          <p>
            But we do occasionally like to leave our screens, climb out of our dark IT
            caves, and squint into the sunlight as we pursue a variety of other
            interests. On our team you will find powerlifters, car enthusiasts, cooks,
            outdoorsmen, musicians, builders and craftsmen, extreme enduro dirt bike
            riders, 3D-printing fanatics, and at least one person (ahem, Colin) that
            makes a daily attempt to start trench warfare in the office over anything
            ranging from politically charged current events to the ideal number of
            episodes per season of a TV series.
          </p>
          <p>
            The newer members of our team learned quickly upon joining AllTech that
            walking away from your computer with your desktop unlocked WILL result in
            rapidly executed IT pranks, like returning to find a digital goose that
            steals your mouse cursor, Baby Shark playing suddenly at random intervals,
            or five different episodes of My Little Pony playing simultaneously on all
            of your workstation screens.
          </p>
        </div>

        <p class="mt-8 text-xl lg:text-2xl font-display font-semibold leading-snug" style="color: var(--color-text-primary);">
          At the end of the day, we love to take our work and your business
          seriously… without taking ourselves too seriously.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
