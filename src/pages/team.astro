      'Placeholder second paragraph. This only appears once Show more is pressed, which is where the longer background, career history, and personal detail belong.',
    ],
    funnyBlurb: 'Placeholder one-liner goes here.',
  },
  {
    name: 'Team Member 06',
    role: 'SOC Analyst',
    bio: [
      'Placeholder bio. The first paragraph is the preview, clamped to two lines on the resting card, so it should stand on its own.',
      'Placeholder second paragraph. This only appears once Show more is pressed, which is where the longer background, career history, and personal detail belong.',
    ],
    funnyBlurb: 'Placeholder one-liner goes here.',
  },
  {
    name: 'Team Member 07',
    role: 'Help Desk Technician',
    bio: [
      'Placeholder bio. The first paragraph is the preview, clamped to two lines on the resting card, so it should stand on its own.',
      'Placeholder second paragraph. This only appears once Show more is pressed, which is where the longer background, career history, and personal detail belong.',
    ],
    funnyBlurb: 'Placeholder one-liner goes here.',
  },
  {
    name: 'Team Member 08',
    role: 'Cloud & Microsoft 365 Administrator',
    bio: [
      'Placeholder bio. The first paragraph is the preview, clamped to two lines on the resting card, so it should stand on its own.',
      'Placeholder second paragraph. This only appears once Show more is pressed, which is where the longer background, career history, and personal detail belong.',
    ],
  },
  {
    name: 'Team Member 09',
    role: 'Field Service Technician',
    bio: [
      'Placeholder bio. The first paragraph is the preview, clamped to two lines on the resting card, so it should stand on its own.',
      'Placeholder second paragraph. This only appears once Show more is pressed, which is where the longer background, career history, and personal detail belong.',
    ],
