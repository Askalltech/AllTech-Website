const slugify = (name: string) =>
  name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? '')
    .join('');
---

<BaseLayout
  title="Our Team"
  description="Meet the engineers behind AllTech — the team that designs, deploys, and runs IT, cybersecurity, and network infrastructure for businesses across Northern Utah."
>
  <section class="surface-dark relative overflow-hidden">
    <div class="glow-amber" style="top: -200px; right: -100px;"></div>
    <div class="relative container-wide py-16 lg:py-20">
      <div class="eyebrow mb-4">Our Team</div>
      <h1 class="font-display text-5xl lg:text-6xl font-bold leading-tight max-w-3xl">
        The people who <span style="color: var(--color-amber-400);">build and run</span> your infrastructure.
      </h1>
      <p class="mt-6 text-xl max-w-2xl leading-relaxed text-muted">
        Real engineers, local since 2009. When you call AllTech, you reach the
        same people who designed your network — not a faceless queue.
      </p>
    </div>
  </section>

  {team.length === 0 ? (
    <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
      <div class="container-wide">
        <div class="max-w-xl">
          <h2 class="font-display text-2xl font-bold mb-3" style="color: var(--color-text-primary);">
            Team profiles are coming soon.
          </h2>
          <p class="text-muted leading-relaxed">
            We're putting together photos and bios for the people you'll work with.
            In the meantime, reach out and we'll connect you with the right engineer.
          </p>
          <a href="/contact" class="btn btn-primary mt-6">Get in touch</a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <!-- The roster grid — an index into the bios below. -->
      <section id="top-of-team" class="surface-dark py-16 lg:py-20 scroll-mt-24" style="border-top: 1px solid var(--color-line-faint);">
        <div class="container-wide">
          <div class="max-w-2xl mb-10">
            <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
              Who you'll actually talk to
            </h2>
            <p class="mt-4 text-muted leading-relaxed">
              Hover for a preview, or pick someone to jump to their full bio.
            </p>
          </div>

          <ul class="team-grid" role="list">
            {team.map((m) => (
              <li class="team-cell">
                <a class="team-inner" href={`#bio-${slugify(m.name)}`}>
                  <span class="team-accent" aria-hidden="true"></span>

                  {m.photo ? (
                    <img src={m.photo} alt="" class="team-photo" loading="lazy" />
                  ) : (
                    <span class="team-monogram" aria-hidden="true">{initials(m.name)}</span>
                  )}

                  <h3 class="font-display text-lg font-bold mt-4" style="color: var(--color-text-primary);">
                    {m.name}
                  </h3>
                  <p class="text-sm font-medium" style="color: var(--color-amber-600);">{m.role}</p>
                  {m.tagline && (
                    <p class="text-xs italic mt-0.5" style="color: var(--color-text-subtle);">{m.tagline}</p>
                  )}

                  <div class="team-reveal">
                    <div>
                      <p class="team-bio text-sm leading-relaxed mt-3" style="color: var(--color-text-default);">{m.bio[0]}</p>
                      <span class="team-more">Read full bio <span aria-hidden="true">↓</span></span>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Full bios. One block per person, anchored so the tiles above can
           link straight to them. -->
      <section class="surface-dark py-16 lg:py-20" style="border-top: 1px solid var(--color-line-faint);">
        <div class="container-wide">
          <div class="max-w-2xl mb-12">
            <div class="eyebrow mb-4">The long version</div>
            <h2 class="font-display text-3xl lg:text-4xl font-bold leading-tight" style="color: var(--color-text-primary);">
              Full bios
            </h2>
          </div>

          <div class="team-bios">
            {team.map((m) => (
              <article id={`bio-${slugify(m.name)}`} class="team-bio-block">
                <div class="team-bio-aside">
                  {m.photo ? (
                    <img src={m.photo} alt={m.name} class="team-bio-photo" loading="lazy" />
                  ) : (
                    <span class="team-bio-monogram" aria-hidden="true">{initials(m.name)}</span>
                  )}
                </div>

                <div class="team-bio-body">
                  <h3 class="font-display text-2xl font-bold" style="color: var(--color-text-primary);">{m.name}</h3>
                  <p class="text-sm font-medium mt-1" style="color: var(--color-amber-600);">{m.role}</p>
                  {m.tagline && (
                    <p class="text-sm italic" style="color: var(--color-text-subtle);">{m.tagline}</p>
                  )}

                  <div class="mt-5 space-y-4 leading-relaxed" style="color: var(--color-text-default);">
                    {m.bio.map((para) => <p>{para}</p>)}
                  </div>

                  {m.funnyBlurb && (
                    <p class="mt-4 italic" style="color: var(--color-amber-600);">“{m.funnyBlurb}”</p>
                  )}

                  <a href="#top-of-team" class="team-backlink">
                    <span aria-hidden="true">↑</span> Back to the team
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>
  )}
</BaseLayout>

<style>
  /* Dense bordered grid. Cell borders are drawn with a shared 1px gap so the
     grid reads as one ruled table rather than separate boxes. */
  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: 12px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .team-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .team-cell {
    position: relative;
    background: var(--color-bg-page);
    min-height: 100%;
  }

  .team-inner {
    display: block;
    padding: 1.75rem 1.5rem;
    height: 100%;
    background: var(--color-bg-page);
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease-out-soft),
      box-shadow 0.2s var(--ease-out-soft);
  }

  /* The amber accent line that appears with the raised card. */
  .team-accent {
    position: absolute;
    left: 0;
    top: 0;
    height: 3px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      90deg,
      var(--color-amber-400),
      var(--color-amber-500) 55%,
      var(--color-teal-400)
    );
    transition: transform 0.25s var(--ease-out-soft);
  }

  .team-photo,
  .team-monogram {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 10px;
    object-fit: cover;
  }
  .team-monogram {
    display: grid;
    place-items: center;
    background: var(--color-bg-tint);
    border: 1px solid var(--color-border-default);
    color: var(--color-amber-600);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
  }

  /* The preview is clamped to two lines — the full text lives below. */
  .team-bio {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .team-more {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-amber-600);
  }

  /* Mobile / touch: the preview is simply always visible — a scannable list. */
  .team-reveal { display: block; }

  @media (min-width: 768px) {
    /* Desktop: the card is absolutely positioned in BOTH states, and the cell
       reserves its own height. That's what keeps neighbours perfectly still —
       if the card only went absolute on hover, its cell would collapse and
       reflow the whole grid. At rest the card fills the cell (inset: 0); when
       active it releases its bottom edge so it can grow downward. */
    .team-cell { min-height: 15rem; }
    .team-inner {
      position: absolute;
      inset: 0;
      height: auto;
    }

    .team-reveal {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.25s var(--ease-out-soft),
        opacity 0.2s var(--ease-out-soft);
    }
    .team-reveal > * { overflow: hidden; }

    .team-cell:hover .team-inner,
    .team-cell:focus-within .team-inner {
      inset: 0 0 auto 0;
      z-index: 20;
      background: var(--color-bg-surface);
      border-radius: 12px;
      box-shadow:
        0 18px 40px -12px rgba(10, 15, 26, 0.18),
        0 0 0 1px var(--color-border-default);
    }
    .team-cell:hover .team-reveal,
    .team-cell:focus-within .team-reveal {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .team-cell:hover .team-accent,
    .team-cell:focus-within .team-accent {
      transform: scaleX(1);
    }
    .team-cell:focus-within .team-inner {
      box-shadow:
        0 18px 40px -12px rgba(10, 15, 26, 0.18),
        0 0 0 2px var(--color-amber-400);
    }
  }

  /* ---- Full bios ---- */
  .team-bios {
    display: grid;
    gap: 0;
  }
  .team-bio-block {
    display: grid;
    gap: 1.5rem 2.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border-subtle);
    /* Clears the sticky header when a tile links here. */
    scroll-margin-top: 6rem;
  }
  .team-bio-block:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 768px) {
    .team-bio-block { grid-template-columns: 10rem minmax(0, 1fr); }
  }

  .team-bio-photo,
  .team-bio-monogram {
    display: block;
    width: 8rem;
    height: 8rem;
    border-radius: 14px;
    object-fit: cover;
  }
  .team-bio-monogram {
    display: grid;
    place-items: center;
    background: var(--color-bg-tint);
    border: 1px solid var(--color-border-default);
    color: var(--color-amber-600);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.25rem;
  }

  .team-bio-body { max-width: 65ch; }

  .team-backlink {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-amber-600);
  }
  .team-backlink:hover { text-decoration: underline; }

  /* A tile linked to a bio flashes the accent briefly so it's obvious where
     the jump landed. */
  .team-bio-block:target .team-bio-body { position: relative; }
  .team-bio-block:target .team-bio-body::before {
    content: "";
    position: absolute;
    left: -1.25rem;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    border-radius: 2px;
    background: var(--color-amber-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-inner,
    .team-reveal,
    .team-accent {
      transition: none;
    }
    html { scroll-behavior: auto; }
  }
</style>
