---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { TeamGrid } from '@/components/TeamGrid';

/**
 * Our Team — roster in the shadcnblocks "team11" pattern.
 *
 * A dense bordered grid of people (2 cols → 3 → 4). Each tile shows photo,
 * name, and role. On md+ screens, hovering (or keyboard-focusing) a tile
 * raises a highlighted overlay card with an amber accent line and reveals a
 * two-line preview of the bio. The overlay is absolutely positioned, so
 * neighbouring tiles never shift.
 *
 * Every tile is a link to that person's FULL bio, rendered in a section
 * below the grid. Real bios run several paragraphs — far too much to expand
 * inside a hover card without running off the viewport — so the tile is the
 * index and the section below is the content. That also means the full text
 * is always in the DOM for search engines and screen readers, and every
 * person has a shareable URL (#bio-their-name).
 *
 * Below md the grid degrades to a plain scannable list with the preview
 * always visible — no hover required on touch.
 *
 * TO ADD SOMEONE: drop an object into `team` below. `photo` is optional —
 * without one, a monogram tile of their initials is shown instead, so names
 * and bios can go live before headshots are ready. Photos live in
 * /public/team/ (e.g. "/team/jane-doe.jpg").
 */
interface Member {
  name: string;
  role: string;
  /**
   * Paragraphs. The FIRST one is the preview — it's clamped to two lines on
   * the resting card, so write it so the opening sentence stands alone.
   * Everything after it appears only once "Show more" is pressed.
   *
   * An entry prefixed with "## " renders as a subheading inside the bio rather
   * than as body copy, for bios that are split into named parts.
   */
  bio: string[];
  tagline?: string;    // short moniker shown under the role, e.g. "The Network Nomad"
  photo?: string;      // optional; falls back to an initials monogram
  funnyBlurb?: string; // a lighthearted one-liner closing out the expanded bio
}

// ROSTER. Rick, Brendan, and Tad are real; the rest are placeholders — replace as bios and
// headshots come in. `photo` is optional, so names and bios can go live before
// the photography does.
const team: Member[] = [
  {
    name: 'Rick Sherwood',
    role: 'Network Engineer',
    tagline: 'The Network Nomad',
    bio: [
      'Rick is a seasoned Network Engineer at AllTech who has officially traded the high seas for high-speed fiber optics. A veteran of the U.S. Navy — where he spent six years as an Electronics Technician across three different ships — Rick\u2019s career path has been anything but a straight line. After wrapping up his service in 2001, he headed to college in San Diego. Following his studies, he moved to Arizona, where he promptly fainted from the heat and woke up five years later just in time to pack his bags and move to Utah.',
      'He survived a 12-year stint at an ISP before finally finding a professional home at AllTech, a place where he\u2019s happy to put down permanent roots for the long haul. When he isn\u2019t deep in firewall configurations or optimizing Linux servers, he\u2019s likely busy tending to his real-world passion: extreme hot sauce. A true heat-seeker, Rick brews his own artisanal batches, subjecting friends and colleagues alike to his latest fiery concoctions.',
      'Outside of the kitchen, Rick maintains a strictly \u201Clook, don\u2019t touch\u201D policy regarding his other two loves: fast cars and motorcycles. It turns out that Rick is remarkably good at making things go fast, but the local police were even better at making him pay for it. Faced with the choice between a pristine driving record and a need for speed, he decided his wallet was much happier keeping both feet firmly on the ground.',
    ],
  },
  {
    name: 'Brendan Gilman',
    role: 'Cybersecurity Specialist',
    bio: [
      'Brendan Gilman joined AllTech in October 2025. Holding a BS in Information Systems with a minor in Data Analytics from Utah State University, he leverages a versatile background in IT support and systems administration to keep client operations running smoothly.',
      'On the security side, Brendan specializes in blue team operations, focusing on incident response, endpoint security, and security awareness training to protect client infrastructure.',
      'Brendan is an absolute nerd for hands-on tinkering, whether that means running a home cybersecurity lab or building and tuning his own custom firearms platforms down to the gas systems and optics. When he isn’t analyzing logs or working with tools, you can find him at the gym, playing bass guitar, reading up on history, or enjoying the great outdoors.',
    ],
  },
  {
    // Supplied verbatim. The one-line opener is deliberate, not a truncation —
    // it stays first because it is what the card preview clamps to.
    name: 'Tad Spiekerman',
    role: 'Systems Administrator',
    bio: [
      'This is Tad. You probably already know Tad. Everybody loves Tad.',
      '## The Myth, The Method, The Tad',
      'Tad did not choose the IT life; the IT life chose him and has regretted it ever since. Operating on the bleeding edge of digital chaos, he navigates Linux terminals like a man who knows exactly what the root directory is thinking. He remains the only admin to route a corporate intranet through a modified toaster, baffling cybersecurity teams for three fiscal quarters.',
      'His routine is fueled by panic, Dr. Pepper, and a belief that Active Directory password policies should just allow “password123” to save everyone the headache. When he isn’t managing the camera systems to secure his office fort of expired server racks, Tad uses a single red button to auto-reply “Have you tried turning it off and on again?” to every frantic ticket.',
    ],
  },
  {
    name: 'Team Member 04',
    role: 'Owner / Principal',
    bio: [
      'Placeholder bio. The first paragraph is the preview, clamped to two lines on the resting card, so it should stand on its own.',
      'Placeholder second paragraph. This only appears once Show more is pressed, which is where the longer background, career history, and personal detail belong.',
    ],
    funnyBlurb: 'Placeholder one-liner goes here.',
  },
  {
