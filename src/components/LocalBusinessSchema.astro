---
import { site } from '~/lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#organization`,
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  logo: `${site.url}/logo.webp`,
  // Same default OG image SEO.astro already falls back to (public/og-default.png
  // doesn't exist yet — tracked in README's "Before launch" checklist; this
  // will resolve once that file is generated, same as the OG tags already do).
  image: `${site.url}/logo.webp`,
  // Populate once real profile URLs exist (LinkedIn, Facebook, industry
  // directories) — site.social is currently empty. Don't fabricate URLs.
  sameAs: [],
  knowsAbout: [
    'Managed IT Services',
    'Cybersecurity',
    'Cloud Computing',
    'Microsoft 365',
    'Network Infrastructure',
    'Zero Trust Security',
    'Backup and Disaster Recovery',
    'VoIP',
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  areaServed: site.serviceArea.map((loc) => ({
    '@type': 'City',
    name: `${loc.city}, ${loc.region}`,
  })),
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.open,
    closes: h.close,
  })),
  priceRange: '$$',
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
