---
import { site } from '~/lib/site';
import { menuCategories, simpleNavLinks, companyLinks } from '~/lib/menu';
import { industries } from '~/lib/industries';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!--
  Header with a UNIFIED mega-panel.

  All four nav triggers (Cybersecurity / Cloudflare / Network / IT & Cloud)
  share ONE panel. Hovering any trigger reveals the shared panel underneath
  the whole nav. This is the cloudflare.com pattern.

  Implementation: a single .mega-zone wraps the four triggers PLUS the panel.
  CSS (in global.css) reveals the panel when any direct child trigger
  (.mega-trigger) is hovered, or when the panel itself is hovered. No JS.

  The triggers themselves are still clickable links to their category's
  landing page — hover opens the panel, click navigates.
-->

<header class="sticky top-4 z-40 px-4 lg:px-6">
  <div
    class="nav-host relative container-wide mx-auto flex items-center justify-between h-16 px-4 lg:px-6 rounded-full backdrop-blur-xl backdrop-saturate-150 bg-white/85 dark:bg-black/80 border border-[var(--color-border-subtle)] shadow-sm"
  >
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 font-display font-semibold tracking-tight text-lg" style="color: var(--color-text-primary)">
      <img src="/logo.webp" alt="" class="h-9 w-auto" width="36" height="36" onerror="this.style.display='none'" />
      AllTech
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">

      <!-- ===================================================================
           MEGA ZONE — single "Services" trigger + the shared 4-column panel
           =================================================================== -->
      <!-- No aria-haspopup / role="menu" on this trigger: the panel below is
           a hover-revealed group of links, not a menu widget, and there is no
           aria-expanded to pair with it. Claiming menu semantics told screen
           reader users to expect arrow-key menu navigation that doesn't exist. -->
      <div class="mega-zone h-16">
        <a
          href="/services"
          class:list={[
            'mega-trigger flex items-center gap-1 whitespace-nowrap px-3.5 py-2 text-sm font-medium rounded-md transition',
            pathname.startsWith('/services') ? 'text-[var(--color-text-primary)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]',
          ]}
        >
          Services
          <svg class="w-3.5 h-3.5 opacity-60" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <!-- The shared panel. Positioned relative to the header's .nav-host
             container and centered beneath the bar (see global.css). -->
        <div class="mega-panel absolute left-1/2 top-full pt-3 z-50" role="group" aria-label="Services">
          <div
            class="rounded-xl shadow-2xl overflow-hidden backdrop-blur-xl backdrop-saturate-150 bg-white/85 dark:bg-black/80"
            style="border: 1px solid var(--color-border-subtle); box-shadow: 0 24px 64px -16px rgba(0,0,0,0.6);"
          >
            <!-- Columns: one per category, separated by a vertical divider -->
            <div class="grid grid-cols-5 p-6">
              {menuCategories.map((cat) => (
                <div class="min-w-0 flex flex-col px-4 first:pl-0 last:pr-0 border-r last:border-r-0" style="border-color: var(--color-border-subtle)">
                  <div class="mb-2 pb-2 border-b" style="border-color: var(--color-border-subtle)">
                    <a
                      href={cat.href}
                      class="block font-display text-base font-bold tracking-tight hover:text-[var(--color-amber-600)] transition"
                      style="color: var(--color-text-primary);"
                    >
                      {cat.label}
                    </a>
                    {/* Always rendered (nbsp when empty) so every column's
                        header block is the same height and the divider +
                        first tiles align across all five columns. */}
                    <div class="text-[10px] font-mono uppercase tracking-[0.12em] mt-0.5" style="color: var(--color-text-subtle)">
                      {cat.sublabel || ' '}
                    </div>
                  </div>
                  <ul class="space-y-0.5">
                    {cat.tiles.map((tile) => (
                      <li>
                        <a
                          href={tile.href}
                          class="group block -mx-2 px-2 py-1.5 rounded-md transition"
                          onmouseenter="this.style.background='var(--color-bg-elevated)'"
                          onmouseleave="this.style.background='transparent'"
                        >
                          <div
                            class="font-medium text-[13px] leading-tight group-hover:text-[var(--color-amber-300)] transition"
                            style="color: var(--color-text-primary);"
                          >
                            {tile.title}
                          </div>
                          <div class="text-[11px] mt-0.5 leading-snug" style="color: var(--color-text-muted)">
                            {tile.description}
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <!-- Footer strip inside the panel -->
            <div
              class="px-6 py-4 flex items-center justify-between border-t"
              style="background: var(--color-bg-page); border-color: var(--color-border-subtle)"
            >
              <span class="text-[11px] font-mono uppercase tracking-[0.18em]" style="color: var(--color-text-subtle)">
                Cloudflare Partner
              </span>
              <a
                href="/services"
                class="inline-flex items-center gap-1.5 text-xs font-medium transition"
                style="color: var(--color-amber-300)"
              >
                See all services <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ===================================================================
           MEGA ZONE — "Industries" trigger + a narrow single-column panel.
           Own independent zone (not sharing the Services panel above), so it
           gets its own reveal state and its own (narrower) panel width via
           .mega-panel-narrow. Each item links to /industries#<slug>; that
           page's SqueezeCarousel (src/components/SqueezeCarousel.tsx) opens
           that industry's slide and scrolls to it when the hash matches.

           mega-zone-self: centers the panel on THIS trigger, not the whole
           nav-host, the way the shared Services panel does (see global.css
           for why that default breaks a narrow panel's clickability).
           =================================================================== -->
      <div class="mega-zone mega-zone-self h-16">
        <a
          href="/industries"
          class:list={[
            'mega-trigger flex items-center gap-1 whitespace-nowrap px-3.5 py-2 text-sm font-medium rounded-md transition',
            'text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]',
          ]}
        >
          Industries
          <svg class="w-3.5 h-3.5 opacity-60" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div class="mega-panel absolute left-1/2 top-full pt-3 z-50" role="group" aria-label="Industries">
          <div
            class="mega-panel-narrow rounded-xl shadow-2xl overflow-hidden backdrop-blur-xl backdrop-saturate-150 bg-white/85 dark:bg-black/80"
            style="border: 1px solid var(--color-border-subtle); box-shadow: 0 24px 64px -16px rgba(0,0,0,0.6);"
          >
            <ul class="p-3">
              {industries.map((industry) => (
                <li>
                  <a
                    href={`/industries#${industry.slug}`}
                    class="group block -mx-2 px-3.5 py-2.5 rounded-md transition"
                    onmouseenter="this.style.background='var(--color-bg-elevated)'"
                    onmouseleave="this.style.background='transparent'"
                  >
                    <div
                      class="font-medium text-[13px] leading-tight group-hover:text-[var(--color-amber-300)] transition"
                      style="color: var(--color-text-primary);"
                    >
                      {industry.title}
                    </div>
                  </a>
                </li>
              ))}
            </ul>

            <div
              class="px-4 py-3 flex items-center justify-between border-t"
              style="background: var(--color-bg-page); border-color: var(--color-border-subtle)"
            >
              <span class="text-[11px] font-mono uppercase tracking-[0.18em]" style="color: var(--color-text-subtle)">
                Who we support
              </span>
              <a
                href="/industries"
                class="inline-flex items-center gap-1.5 text-xs font-medium transition"
                style="color: var(--color-amber-300)"
              >
                See all <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ===================================================================
           MEGA ZONE — "Company" trigger + a narrow single-column panel.
           Same pattern as Industries above: own zone, own (narrow) panel,
           mega-zone-self so the panel centers on this trigger rather than
           the whole nav-host. Groups the site's non-service pages plus the
           service-area index — ntiva.com puts location pages under an
           "About" column inside a "Company" menu rather than as their own
           top-nav item; this is the same idea sized to what AllTech has.
           =================================================================== -->
      <div class="mega-zone mega-zone-self h-16">
        <a
          href="/team"
          class:list={[
            'mega-trigger flex items-center gap-1 whitespace-nowrap px-3.5 py-2 text-sm font-medium rounded-md transition',
            'text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]',
          ]}
        >
          Company
          <svg class="w-3.5 h-3.5 opacity-60" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div class="mega-panel absolute left-1/2 top-full pt-3 z-50" role="group" aria-label="Company">
          <div
            class="mega-panel-narrow rounded-xl shadow-2xl overflow-hidden backdrop-blur-xl backdrop-saturate-150 bg-white/85 dark:bg-black/80"
            style="border: 1px solid var(--color-border-subtle); box-shadow: 0 24px 64px -16px rgba(0,0,0,0.6);"
          >
            <ul class="p-3">
              {companyLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="group block -mx-2 px-3.5 py-2.5 rounded-md transition"
                    onmouseenter="this.style.background='var(--color-bg-elevated)'"
                    onmouseleave="this.style.background='transparent'"
                  >
                    <div
                      class="font-medium text-[13px] leading-tight group-hover:text-[var(--color-amber-300)] transition"
                      style="color: var(--color-text-primary);"
                    >
                      {link.label}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Divider + simple links -->
      <div class="mx-3 h-5 w-px" style="background: var(--color-border-subtle)"></div>
      {simpleNavLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'whitespace-nowrap px-3.5 py-2 text-sm font-medium rounded-md transition',
            isActive(link.href) ? 'text-[var(--color-text-primary)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right cluster -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phoneE164}`}
        class="hidden md:inline text-sm font-mono transition"
        style="color: var(--color-text-muted)"
        onmouseover="this.style.color='var(--color-text-primary)'"
        onmouseout="this.style.color='var(--color-text-muted)'"
      >
        {site.phone}
      </a>
      <a href="/contact" class="hidden sm:inline-flex btn btn-primary text-sm">Get in touch</a>

      <ThemeToggle />

      <!-- Mobile menu toggle -->
      <button
        id="mobile-nav-toggle"
        type="button"
        class="lg:hidden p-2 rounded-md"
        style="color: var(--color-text-primary); border: 1px solid var(--color-border-default);"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav drawer (mega-menu collapses to accordions per category) -->
  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="container-wide lg:hidden hidden mt-2 rounded-2xl border shadow-sm"
    style="background: var(--color-bg-surface); border-color: var(--color-border-subtle);"
  >
    <div class="px-5 py-5 space-y-1">
      {menuCategories.map((cat) => (
        <details class="group">
          <summary
            class="flex items-center justify-between cursor-pointer py-3 font-medium"
            style="color: var(--color-text-primary)"
          >
            <span>
              {cat.label}
              {cat.sublabel && <span class="text-xs font-normal ml-2" style="color: var(--color-text-subtle)">{cat.sublabel}</span>}
            </span>
            <svg class="w-4 h-4 transition group-open:rotate-180" viewBox="0 0 12 12" fill="none">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="pl-3 pb-3 space-y-1">
            {cat.tiles.map((tile) => (
              <a
                href={tile.href}
                class="block py-2 text-sm"
                style="color: var(--color-text-muted)"
              >
                {tile.title}
              </a>
            ))}
          </div>
        </details>
      ))}
      <details class="group">
        <summary
          class="flex items-center justify-between cursor-pointer py-3 font-medium"
          style="color: var(--color-text-primary)"
        >
          <span>Industries</span>
          <svg class="w-4 h-4 transition group-open:rotate-180" viewBox="0 0 12 12" fill="none">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pl-3 pb-3 space-y-1">
          {industries.map((industry) => (
            <a
              href={`/industries#${industry.slug}`}
              class="block py-2 text-sm"
              style="color: var(--color-text-muted)"
            >
              {industry.title}
            </a>
          ))}
        </div>
      </details>
      <details class="group">
        <summary
          class="flex items-center justify-between cursor-pointer py-3 font-medium"
          style="color: var(--color-text-primary)"
        >
          <span>Company</span>
          <svg class="w-4 h-4 transition group-open:rotate-180" viewBox="0 0 12 12" fill="none">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pl-3 pb-3 space-y-1">
          {companyLinks.map((link) => (
            <a
              href={link.href}
              class="block py-2 text-sm"
              style="color: var(--color-text-muted)"
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>
      <div class="hairline my-3"></div>
      {simpleNavLinks.map((link) => (
        <a href={link.href} class="block py-2.5 font-medium" style="color: var(--color-text-primary)">
          {link.label}
        </a>
      ))}
      <a href="/contact" class="sm:hidden btn btn-primary w-full mt-2">Get in touch</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    btn.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
    nav?.classList.toggle('hidden');
  });
</script>
