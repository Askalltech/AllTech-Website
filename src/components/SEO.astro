---
import { site } from '~/lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Canonical URL override (defaults to current URL) */
  canonical?: string;
  /** og:type — "article" for blog posts and case studies, else "website". */
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  description = site.description,
  // /public/og-default.png — a purpose-made 1200x630 (1.91:1) card, which is
  // what the twitter:card="summary_large_image" below actually expects. This
  // used to fall back to /logo.webp, which at 300x203 cleared the 200x200
  // floor platforms require but rendered as a small square thumbnail rather
  // than a wide banner. Regenerate the card from the same brand tokens
  // (--color-bg-page, --color-amber-400, Space Grotesk) if the logo or
  // tagline changes.
  image = '/og-default.png',
  noindex = false,
  canonical,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

// Strip the trailing slash so the canonical matches the sitemap and the
// site's own trailingSlash: 'never' config (the root would otherwise emit
// ".../" while the sitemap lists the bare origin).
const rawCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const canonicalURL = rawCanonical.length > 1 ? rawCanonical.replace(/\/$/, '') : rawCanonical;
const ogImageURL = new URL(image, Astro.site).toString();

// Title pattern: "Page Title — AllTech" except the home page which uses the brand tagline.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
// The home page used the full tagline, which rendered an 83-character title —
// well past the ~60 chars search results and RAG cards keep before truncating.
// site.tagline itself is unchanged (it's the brand line, used as prose
// elsewhere); the home title is just its short form, leading with the entity
// keyword. See claude.md Guardrail B.
const HOME_TITLE = `${site.name} — Managed IT & Cybersecurity in Northern Utah`;
const fullTitle = isHome ? HOME_TITLE : `${title} — ${site.name}`;
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="en_US" />
{ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
{ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
{ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Slot for page-specific JSON-LD (Service, Article, etc.) -->
<slot />
