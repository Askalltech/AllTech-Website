---
import { site } from '~/lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Canonical URL override (defaults to current URL) */
  canonical?: string;
  /** og:type — "article" for blog posts and case studies, else "website". */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  // /og-default.png was referenced here but never created, so every page's
  // social preview and the LocalBusiness schema image pointed at a 404.
  // Using the real logo until a purpose-made card exists: at 300x203 it
  // clears the 200x200 floor platforms require, so previews render — just as
  // a small thumbnail rather than a wide 1.91:1 banner. Dropping a
  // 1200x630 og-default.png into /public and changing this one line back is
  // the proper fix.
  image = '/logo.webp',
  noindex = false,
  canonical,
  ogType = 'website',
} = Astro.props;

// Strip the trailing slash so the canonical matches the sitemap and the
// site's own trailingSlash: 'never' config (the root would otherwise emit
// ".../" while the sitemap lists the bare origin).
const rawCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const canonicalURL = rawCanonical.length > 1 ? rawCanonical.replace(/\/$/, '') : rawCanonical;
const ogImageURL = new URL(image, Astro.site).toString();

// Title pattern: "Page Title — AllTech" except the home page which uses the brand tagline.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const fullTitle = isHome ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Slot for page-specific JSON-LD (Service, Article, etc.) -->
<slot />
