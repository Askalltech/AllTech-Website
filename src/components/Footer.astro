---
import { site, services, serviceLink } from '~/lib/site';
import { industries } from '~/lib/industries';
import { companyLinks } from '~/lib/menu';
import { SystemTelemetry } from '@/components/SystemTelemetry';
const year = new Date().getFullYear();

// Technology we deploy & support (replaces the old service-area list).
const partners = ['Cloudflare', 'Ubiquiti UniFi', 'Microsoft 365', 'Datto', 'Entra ID'];
---

<!-- The page-wide matrix dot grid (GlobalBackground.astro, fixed behind the
     whole page) is at its densest right at the viewport bottom, which is
     where the footer usually sits — dimming the global mask wasn't enough
     to keep footer text readable against it. Rather than going fully
     transparent (which let the dots compete with small/muted text) or
     fully opaque (which reintroduces the hard seam this used to avoid),
     the footer fades in its own solid backing from transparent at the top
     edge to fully opaque by the time real content starts, so the dot grid
     softly resolves away before it reaches any text. -->
<footer style="background: linear-gradient(to bottom, transparent, var(--color-bg-page) 96px, var(--color-bg-page) 100%);">
  <div class="container-footer" style="border-left: 1px solid var(--color-border-subtle); border-right: 1px solid var(--color-border-subtle);">
    <div class="px-6 lg:px-8 py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-6">
      <div class="sm:col-span-2 lg:col-span-2">
        <div class="flex items-center gap-2.5 font-display font-semibold text-lg mb-4" style="color: var(--color-text-primary)">
          <img src="/logo.webp" alt="" class="h-9 w-auto" width="36" height="36" onerror="this.style.display='none'" />
          AllTech
        </div>
        <p class="text-sm max-w-sm leading-relaxed" style="color: var(--color-text-muted)">
          Managed IT, cybersecurity, and Cloudflare-powered network infrastructure —
          rooted in Cache Valley, Northern Utah, and the Wasatch Front.
        </p>

        <address class="mt-6 not-italic text-sm space-y-1.5" style="color: var(--color-text-muted)">
          <div>{site.address.street}</div>
          <div>{site.address.city}, {site.address.region} {site.address.postalCode}</div>
          <div>
            <a href={`tel:${site.phoneE164}`} class="font-mono hover:text-[var(--color-text-primary)] transition" style="color: var(--color-text-default)">
              {site.phone}
            </a>
          </div>
        </address>
      </div>

      <div>
        <h3 class="font-display text-sm uppercase tracking-wider mb-4" style="color: var(--color-text-primary)">Services</h3>
        <ul class="space-y-2 text-sm">
          {services.map((s) => {
            const { href, external } = serviceLink(s);
            return (
              <li>
                <a
                  href={href}
                  class="transition hover:text-[var(--color-text-primary)]"
                  style="color: var(--color-text-muted)"
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {s.name}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm uppercase tracking-wider mb-4" style="color: var(--color-text-primary)">Industries</h3>
        <ul class="space-y-2 text-sm">
          {industries.map((industry) => (
            <li>
              <a
                href={`/industries#${industry.slug}`}
                class="transition hover:text-[var(--color-text-primary)]"
                style="color: var(--color-text-muted)"
              >
                {industry.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm uppercase tracking-wider mb-4" style="color: var(--color-text-primary)">Company</h3>
        <ul class="space-y-2 text-sm">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="transition hover:text-[var(--color-text-primary)]"
                style="color: var(--color-text-muted)"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/insights"
              class="transition hover:text-[var(--color-text-primary)]"
              style="color: var(--color-text-muted)"
            >
              Insights
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm uppercase tracking-wider mb-4" style="color: var(--color-text-primary)">Technology</h3>
        <ul class="space-y-2 text-sm">
          {partners.map((p) => (
            <li style="color: var(--color-text-muted)">{p}</li>
          ))}
        </ul>
      </div>
    </div>
    </div>

    <!-- Faint diagonal-hatch band, bordered top — echoes shadcnblocks'
         footer51 bottom bar, tinted with the site's own border token
         instead of shadcn's --border so it stays on-brand in both themes. -->
    <div
      class="px-6 lg:px-8 py-8 flex flex-col sm:flex-row justify-between gap-4 text-xs [background-image:repeating-linear-gradient(-45deg,color-mix(in_oklch,var(--color-border-subtle)_45%,transparent)_0,color-mix(in_oklch,var(--color-border-subtle)_45%,transparent)_1px,transparent_1px,transparent_8px)]"
      style="border-top: 1px solid var(--color-border-subtle); color: var(--color-text-subtle)"
    >
      <div class="space-y-2">
        <div>© {year} AllTech. All rights reserved.</div>
        <SystemTelemetry client:visible />
      </div>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:text-[var(--color-text-primary)] transition">Privacy</a>
        <a href="/terms" class="hover:text-[var(--color-text-primary)] transition">Terms</a>
        <a href="https://remote.askalltech.com:8040" class="hover:text-[var(--color-text-primary)] transition">Remote Assistance</a>
      </div>
    </div>
  </div>
</footer>
