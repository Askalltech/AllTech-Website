---
// Light/dark toggle. The actual .dark class is set before paint by the
// inline script in BaseLayout.astro (FOUC guard); this component only
// needs to flip it on click and persist the choice.
---

<button
  id="theme-toggle"
  type="button"
  class="p-2 rounded-md transition"
  style="color: var(--color-text-muted); border: 1px solid var(--color-border-default);"
  aria-label="Dark mode"
  aria-pressed="false"
>
  <!-- Sun: shown in dark mode (click to go light) -->
  <svg id="theme-toggle-sun" class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0l-1.414-1.414M7.05 7.05L5.636 5.636M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- Moon: shown in light mode (click to go dark) -->
  <svg id="theme-toggle-moon" class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  // Reflect the current mode to assistive tech. The class itself is set
  // pre-paint by the FOUC guard in BaseLayout, so sync once on load too —
  // otherwise the control always announces "not pressed" regardless of theme.
  const syncPressed = () =>
    btn?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
  syncPressed();
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    syncPressed();
  });
</script>
