---
/**
 * Client logo marquee, shown site-wide just above the footer.
 *
 * Uses the robust two-group marquee pattern: two identical groups, each at least
 * as wide as the viewport (min-width:100%), both translating -100% in sync — so
 * the row is always full and loops seamlessly on any screen width. Pauses on
 * hover/focus, fades at both edges, and falls back to a static wrapped row for
 * reduced-motion users.
 *
 * Add each logo file to /public/logos/ and append to this array (keep the real
 * file extension — the set is a mix of png/jpeg/webp).
 */
const clients = [
  { src: '/logos/als.png', alt: "AL'S" },
  { src: '/logos/beazer-lock-key.webp', alt: 'Beazer Lock & Key' },
  { src: '/logos/caspers-ice-cream.png', alt: "Casper's Ice Cream" },
  { src: '/logos/ducworks.png', alt: 'Ducworks, Inc.' },
  { src: '/logos/double-l-ranch-meats.png', alt: 'Double L Ranch Meats' },
  { src: '/logos/northern-title.webp', alt: 'Northern Title' },
  { src: '/logos/plastics-resources.webp', alt: 'Plastics Resources Incorporated' },
  { src: '/logos/richmond-utah.png', alt: 'Richmond, Utah' },
  { src: '/logos/spartan.webp', alt: 'Spartan' },
  { src: '/logos/newton-town.png', alt: 'Newton, Utah' },
  { src: '/logos/smithfield-city.png', alt: 'Smithfield, Utah' },
  { src: '/logos/ag_needs_inc_logo.png', alt: 'AG Needs Inc.' },
  { src: '/logos/caffeibis.png', alt: 'Caffe Ibis Coffee Roasting Company' },
  { src: '/logos/jaydee-barr-constr-logo.png', alt: 'Jaydee Barr Construction' },
  { src: '/logos/lowerfoods.png', alt: 'Lower Family Foods' },
  { src: '/logos/sierra-homes.png', alt: 'Sierra Homes' },
  { src: '/logos/mendon-city.png', alt: 'Mendon, Utah' },
  { src: '/logos/river-heights-city.png', alt: 'River Heights, Utah' },
  { src: '/logos/willard-city.png', alt: 'Willard, Utah' },
  { src: '/logos/rocky-mountain-cpa.png', alt: 'Rocky Mountain CPA Group' },
  { src: '/logos/arrow-fence-logo.png', alt: 'Arrow Fence' },
  { src: '/logos/lifestyle-engineering.png', alt: 'Lifestyle Engineering' },
  { src: '/logos/lifestyle-manufacturing.png', alt: 'Lifestyle Manufacturing' },
];
---

<!-- This strip sits OUTSIDE <main>, between it and the footer. Transparent
     (no local dot-grid copy) so the single, page-wide matrix dot grid
     (GlobalBackground.astro, fixed behind the whole page) shows through
     uniformly instead of this section painting its own separate, unmasked
     copy — that produced a visible seam against the rest of the page. --><section class="relative isolate py-12 border-t" style="border-color: var(--color-border-subtle)">
  <p class="text-center eyebrow mb-10">Trusted by dozens of businesses</p>
  <div class="marquee" aria-label="Businesses we serve">
    <ul class="marquee-group">
      {clients.map((c) => (
        <li>
          <img src={c.src} alt={c.alt} class="client-logo" loading="lazy" onerror="this.style.display='none'" />
        </li>
      ))}
    </ul>
    <ul class="marquee-group" aria-hidden="true">
      {clients.map((c) => (
        <li>
          <img src={c.src} alt="" class="client-logo" loading="lazy" onerror="this.style.display='none'" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee {
    --gap: 7rem;
    display: flex;
    gap: var(--gap);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .marquee-group {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: var(--gap);
    min-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Duration is computed at runtime (see the script below) from the
       actual rendered width of the logo strip, targeting a fixed
       px/second scroll speed — not a hardcoded seconds value. A fixed
       duration drifts every time a logo is added, removed, resized, or
       re-cropped (this happened twice: once going from 9→23 logos, once
       when cropping changed several logos' rendered aspect ratio), so the
       speed silently changes each time someone edits the `clients` array.
       Measuring width and dividing by a constant speed makes it
       self-correcting. 108s/125s here are just the pre-JS fallback for
       the split second before the script runs (avoids a jump/flash). */
    animation: client-marquee var(--marquee-duration, 125s) linear infinite;
  }
  .marquee:hover .marquee-group,
  .marquee:focus-within .marquee-group {
    animation-play-state: paused;
  }
  .client-logo {
    height: 3.5rem;              /* 56px mobile */
    width: auto;
    /* 190px was clipping the height of any wide-aspect logo (ratio > ~2.64)
       down below the target height — e.g. Beazer (aspect 2.99) rendered at
       only ~59px tall instead of the intended 72px on desktop, next to
       square/tall logos at full height, reading as noticeably smaller.
       220px covers most of the set's aspect ratios without letting the most
       extreme banner-shaped wordmarks (Sierra Homes, Spartan) balloon out
       of proportion — those still get capped, which is the right tradeoff. */
    max-width: 220px;
    object-fit: contain;
    transition: opacity 0.2s var(--ease-out-soft);
  }
  @media (min-width: 1024px) {
    .client-logo { height: 4.5rem; }  /* 72px desktop — bigger so small logos read */
  }
  @keyframes client-marquee {
    to { transform: translateX(calc(-100% - var(--gap))); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee { mask-image: none; -webkit-mask-image: none; }
    .marquee-group {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      min-width: 0;
      row-gap: 2rem;
    }
    .marquee-group[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  // Keeps scroll speed constant regardless of how many logos are in the
  // list or how they're sized/cropped — see the comment on `animation` in
  // the <style> block above for why this exists instead of a hardcoded
  // duration.
  const SPEED_PX_PER_SEC = 36; // matches the original 9-logo marquee's pace (~1527px / 42s)

  function setMarqueeDuration() {
    const groups = document.querySelectorAll<HTMLElement>('.marquee-group');
    if (!groups.length) return;
    const width = groups[0].getBoundingClientRect().width;
    if (!width) return;
    const duration = Math.round((width / SPEED_PX_PER_SEC) * 10) / 10;
    groups.forEach((g) => g.style.setProperty('--marquee-duration', `${duration}s`));
  }

  const images = document.querySelectorAll<HTMLImageElement>('.marquee-group img');
  // These are loading="lazy" for real users' network performance, but most
  // of them sit far outside the initial viewport (the strip is laid out
  // horizontally across ~4500px+ and clipped by overflow:hidden, not
  // natively scrolled), so the browser never fetches — and never fires
  // load/error on — most of them. Waiting on those events left `remaining`
  // stuck above 0 forever, so the duration silently never updated and the
  // CSS fallback default was the only value that ever applied, no matter
  // what actually changed. Force them to load immediately for measurement.
  images.forEach((img) => { img.loading = 'eager'; });
  const pending = [...images].filter((img) => !img.complete);
  if (pending.length === 0) {
    setMarqueeDuration();
  } else {
    let remaining = pending.length;
    const finish = () => { if (remaining > 0) { remaining = 0; setMarqueeDuration(); } };
    pending.forEach((img) => {
      const done = () => {
        remaining -= 1;
        if (remaining === 0) setMarqueeDuration();
      };
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    });
    // Safety net: proceed with whatever width is available rather than
    // risk staying on the static fallback if a request stalls.
    setTimeout(finish, 2000);
  }
</script>
