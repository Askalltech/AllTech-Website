# Build-time environment variables (read via import.meta.env — Vite bakes
# these into the compiled output at `astro build` time, so a change here
# needs a rebuild, not just a restart of `astro dev`).
#
# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is for LOCAL DEV ONLY — on the deployed Worker these same names
# are set under Cloudflare dashboard -> Settings -> Builds -> Variables and
# secrets, not here. See README.md's "Environment variables" section for the
# full three-way split (build-time / runtime secret / runtime plain var).

# Cloudflare Turnstile public site key (safe to expose to the browser).
# Get it from the Cloudflare dashboard -> Turnstile -> the widget for this
# site. Without it, the contact/assessment forms render without a captcha
# and skip Turnstile verification entirely (see src/lib/turnstile.ts) —
# fine for local dev, not for anything that ships.
PUBLIC_TURNSTILE_SITE_KEY=

# Only needed if you're pulling new component blocks from shadcnblocks.com
# (see README.md's "Design system" section). Not used at runtime — the
# deployed Worker never needs this set.
SHADCNBLOCKS_API_KEY=
