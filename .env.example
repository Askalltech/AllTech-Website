# Build-time environment variables (read via `import.meta.env` and baked into
# the compiled output by Vite during `astro build` / `astro dev`).
#
# Copy this file to `.env.local` (gitignored) and fill in real values. These
# are NOT runtime secrets — see `.dev.vars.example` for those, and see
# README.md → "Environment variables" for the full three-way split.

# Cloudflare Turnstile PUBLIC site key. Optional locally: with it unset, the
# contact/assessment forms render without the captcha widget and stay usable.
# NOTE: because it's build-time, changing it requires a rebuild (not just a
# redeploy) to take effect. If you set this, you must also set TURNSTILE_SECRET
# (see .dev.vars.example) or the form endpoints will fail closed.
PUBLIC_TURNSTILE_SITE_KEY=

# shadcnblocks registry API key — ONLY needed locally when pulling a new block
# via `npx shadcn@latest add @shadcnblocks/<name>` (see README → "Design
# system"). Requires a shadcnblocks.com subscription. Not used at runtime, so
# it never needs to be set on the Worker. `components.json` reads it as
# ${SHADCNBLOCKS_API_KEY}.
SHADCNBLOCKS_API_KEY=
